{
  "name": "herder-pi",
  "version": "0.14.0",
  "description": "Native Pi extension for Herder's durable multi-agent plan execution.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "orchestration",
    "subagents",
    "worktrees"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minhuw/skills.git"
  },
  "scripts": {
    "test:pi": "node --experimental-strip-types --test pi/herder/test/*.test.ts",
    "typecheck:pi": "tsc -p tsconfig.json"
  },
  "pi": {
    "extensions": [
      "./pi/herder/index.ts"
    ],
    "subagents": {
      "agents": [
        "./pi/herder/agents"
      ]
    }
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.0",
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@types/node": "24.12.0",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
