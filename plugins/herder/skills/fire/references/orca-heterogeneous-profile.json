{
  "schemaVersion": 1,
  "name": "codex-grok-pi",
  "runtime": "orca",
  "controllerInOrca": true,
  "roles": {
    "controller": {
      "harness": "codex",
      "provider": "openai-codex",
      "model": "gpt-5.6-sol",
      "effort": "max",
      "mutates": true,
      "command": [
        "codex",
        "--model",
        "gpt-5.6-sol",
        "-c",
        "model_reasoning_effort=\"max\"",
        "--dangerously-bypass-approvals-and-sandbox"
      ]
    },
    "plan-implementer": {
      "harness": "grok-build",
      "provider": "xai",
      "model": "grok-4.5",
      "effort": "high",
      "mutates": true,
      "command": [
        "grok",
        "--model",
        "grok-4.5",
        "--effort",
        "high",
        "--always-approve",
        "--no-subagents",
        "--no-auto-update"
      ]
    },
    "plan-reviewer": {
      "harness": "pi",
      "provider": "kimi-coding",
      "model": "k3",
      "effort": "max",
      "mutates": false,
      "command": [
        "pi",
        "--model",
        "kimi-coding/k3",
        "--thinking",
        "max",
        "--approve",
        "--no-skills",
        "--no-prompt-templates",
        "--tools",
        "read,bash,grep,find,ls"
      ]
    },
    "plan-judge": {
      "harness": "pi",
      "provider": "openai",
      "model": "gpt-5.6-sol",
      "effort": "max",
      "mutates": false,
      "command": [
        "pi",
        "--model",
        "openai/gpt-5.6-sol",
        "--thinking",
        "max",
        "--approve",
        "--no-extensions",
        "--no-skills",
        "--no-prompt-templates",
        "--tools",
        "read,bash,grep,find,ls"
      ]
    },
    "plan-saver": {
      "harness": "grok-build",
      "provider": "xai",
      "model": "grok-4.5",
      "effort": "high",
      "mutates": true,
      "command": [
        "grok",
        "--model",
        "grok-4.5",
        "--effort",
        "high",
        "--always-approve",
        "--no-subagents",
        "--no-auto-update"
      ]
    }
  }
}
